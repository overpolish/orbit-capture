{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit Capture",
  "version": "0.1.0",
  "identifier": "com.orbitcapture.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "recording-bar",
        "title": "Orbit Capture Recording Bar",
        "url": "/recording-bar",
        "width": 628,
        "height": 92,
        "acceptFirstMouse": true,
        "alwaysOnTop": false,
        "decorations": false,
        "focus": false,
        "resizable": false,
        "shadow": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false,
        "windowEffects": {
          "effects": ["underWindowBackground", "mica"],
          "radius": 10,
          "state": "active"
        }
      },
      {
        "label": "recording-source-selector",
        "title": "Orbit Capture Recording Source Selector",
        "url": "/recording-source-selector",
        "width": 300,
        "height": 40,
        "acceptFirstMouse": true,
        "alwaysOnTop": false,
        "decorations": false,
        "focus": false,
        "resizable": false,
        "shadow": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false,
        "windowEffects": {
          "effects": ["underWindowBackground", "mica"],
          "radius": 10,
          "state": "active"
        }
      },
      {
        "label": "region-selector",
        "title": "Orbit Capture Region Selector",
        "url": "/region-selector",
        "acceptFirstMouse": true,
        "alwaysOnTop": true,
        "decorations": false,
        "focus": false,
        "fullscreen": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false
      },
      {
        "label": "recording-options",
        "title": "Orbit Capture Recording Options",
        "url": "/recording-options",
        "width": 240,
        "height": 270,
        "acceptFirstMouse": true,
        "alwaysOnTop": false,
        "decorations": false,
        "focus": false,
        "resizable": false,
        "shadow": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false,
        "windowEffects": {
          "effects": ["underWindowBackground", "mica"],
          "radius": 10,
          "state": "active"
        }
      },
      {
        "label": "standalone-listbox",
        "title": "Orbit Capture Listbox",
        "url": "/standalone-listbox",
        "width": 208,
        "height": 40,
        "acceptFirstMouse": true,
        "alwaysOnTop": false,
        "decorations": false,
        "focus": false,
        "resizable": false,
        "shadow": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false,
        "windowEffects": {
          "effects": ["underWindowBackground", "mica"],
          "radius": 10,
          "state": "active"
        }
      },
      {
        "label": "recording-dock",
        "title": "Orbit Capture Recording Dock",
        "url": "/recording-dock",
        "width": 216,
        "height": 44,
        "acceptFirstMouse": true,
        "alwaysOnTop": true,
        "decorations": false,
        "focus": false,
        "resizable": false,
        "shadow": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false,
        "windowEffects": {
          "effects": ["underWindowBackground", "mica"],
          "radius": 10,
          "state": "active"
        }
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/OrbitCapture/application-sources/**",
          "$TEMP/OrbitCapture/window-selector/**"
        ]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
