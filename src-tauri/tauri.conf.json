{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit Capture",
  "version": "0.1.0",
  "identifier": "com.orbitcapture.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "recording-bar",
        "title": "Orbit Capture Recording Bar",
        "url": "/recording-bar",
        "width": 500,
        "height": 92,
        "acceptFirstMouse": true,
        "alwaysOnTop": true,
        "decorations": false,
        "focus": false,
        "resizable": false,
        "shadow": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false,
        "windowEffects": {
          "effects": ["underWindowBackground", "mica"],
          "radius": 10,
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
