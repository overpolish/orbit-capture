{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for Orbit Capture windows",
  "windows": [
    "export",
    "recording-bar",
    "recording-dock",
    "recording-source-selector",
    "region-selector",
    "recording-options",
    "standalone-listbox",
    "permissions"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:deny-internal-toggle-maximize"
  ]
}
