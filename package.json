{
  "name": "screenwide",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "build": "pnpm ffmpeg:prepare && pnpm ffmpeg:verify-release && tsc && vite build",
    "architecture:check": "node scripts/check-source-size.mjs",
    "build-storybook": "storybook build",
    "check": "pnpm license:check && pnpm architecture:check && pnpm knip && pnpm format:check && pnpm build && pnpm build-storybook && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo build --manifest-path src-tauri/Cargo.toml",
    "dev": "pnpm ffmpeg:prepare && vite",
    "dev:updater": "node scripts/dev-updater-preview.mjs",
    "ffmpeg:prepare": "node scripts/prepare-ffmpeg.mjs",
    "ffmpeg:verify-release": "node scripts/verify-ffmpeg-release.mjs",
    "format": "prettier --write . && eslint . --fix && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "prettier --check . && eslint . && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "license:check": "node scripts/check-spdx.mjs",
    "preview": "vite preview",
    "release:check-version": "node scripts/check-release-version.mjs",
    "storybook": "storybook dev -p 6006",
    "tauri": "tauri",
    "update:preview": "storybook dev -p 6006 --initial-path=/story/features-update-prompt--available",
    "update:staging": "node scripts/build-staging-update-client.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "motion": "^13.0.0",
    "overlayscrollbars": "2.16.0",
    "overlayscrollbars-react": "0.5.6",
    "react": "^19.1.0",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.1.0",
    "react-rnd": "^10.5.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.3",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/react": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.9.0",
    "knip": "^6.32.1",
    "prettier": "^3.9.6",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  }
}
