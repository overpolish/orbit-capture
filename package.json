{
  "name": "orbit-capture",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "check": "pnpm format:check && pnpm build && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "dev": "vite",
    "format": "prettier --write . && eslint . --fix && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "prettier --check . && eslint . && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.3",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  }
}
